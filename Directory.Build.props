<Project>
  <!--
    Ortak derleme ayarları. lib/ altındaki replay kütüphaneleri (FortniteReplayDecompressor, MIT)
    TargetFramework belirtmez; buradaki değeri kullanır.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Vendor edilmiş kütüphanenin null-uyarıları derlemeyi kirletmesin. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8629;CS0168;CS0219;CS1998;CS8619;CS8620;CS8765;CS8767;NU1603</NoWarn>
    <Company>Fortnite Companion</Company>
    <Product>Fortnite Companion</Product>
    <Version>0.3.0</Version>
  </PropertyGroup>
</Project>
