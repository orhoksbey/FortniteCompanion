<UserControl x:Class="FortniteCompanion.Views.MatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
      <TextBlock Text="MAÇ GEÇMİŞİ" Style="{StaticResource TitleText}" />
      <TextBlock Style="{StaticResource HintText}"
                 Text="Her satır bir oyuncunun bir maçtaki tekilleştirilmiş değeridir. Parantez içindeki sandık sayıları toplama dahil değildir (nedeni Not sütununda)." />
    </StackPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10,12,4">
      <WrapPanel>
        <ComboBox ItemsSource="{Binding PlayerFilterOptions}" SelectedItem="{Binding FilterPlayer}" Width="170" />
        <ComboBox ItemsSource="{Binding SourceFilterOptions}" SelectedItem="{Binding FilterSource}" Width="150" />
        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="Mod, tarih, oyuncu veya not içinde ara" />
        <CheckBox Content="Yalnızca sayılanlar" IsChecked="{Binding OnlyCounted}" Margin="4,6,14,6" />
        <CheckBox Content="Yalnızca uyarılı" IsChecked="{Binding OnlyFlagged}" Margin="0,6,14,6" />
        <TextBlock Text="{Binding MatchSummary}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,0,6" />
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10,12,2">
      <WrapPanel>
        <Button Content="Seçili maçı hariç tut / dahil et" Click="OnToggleExclude" />
        <Button Content="Örtüşen maçı yine de dahil et" Click="OnOverlapInclude"
                ToolTip="Başlangıç tarihinden önce oynanmış bir maçın geçmiş değerlere dahil olmadığından eminseniz" />
        <Button Content="Manuel maç ekle…" Click="OnAddManual" />
        <Button Content="CSV olarak dışa aktar…" Click="OnExportCsv" Style="{StaticResource AccentButton}" />
        <Button Content="Değişiklik geçmişi…" Click="OnEditLog" />
      </WrapPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="6">
      <DataGrid x:Name="MatchGrid" ItemsSource="{Binding FilteredMatches}" RowHeight="NaN" MinRowHeight="30">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" SortMemberPath="StartedUtc" Width="130" />
          <DataGridTextColumn Header="Oyuncu" Binding="{Binding Player}" Width="100" />
          <DataGridTextColumn Header="Sandık" Binding="{Binding ChestsText}" SortMemberPath="Chests" Width="70" />
          <DataGridTextColumn Header="Kill" Binding="{Binding KillsText}" SortMemberPath="Kills" Width="50" />
          <DataGridTextColumn Header="Mod" Binding="{Binding Mode}" Width="150" />
          <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="90" />
          <DataGridTextColumn Header="Sıra" Binding="{Binding Placement}" Width="55" />
          <DataGridTemplateColumn Header="Kaynak" SortMemberPath="Source" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Source}" ToolTip="{Binding SourceLong}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Güvenilirlik" Binding="{Binding Reliability}" Width="120" />
          <DataGridTextColumn Header="Mühimmat" Binding="{Binding AmmoBoxes}" Width="75" />
          <DataGridTextColumn Header="Diğer konteyner" Binding="{Binding OtherContainers}" Width="105" />
          <DataGridTemplateColumn Header="Türler / Not" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Kinds}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Kinds}" />
                  <TextBlock Text="{Binding Flag}" Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Flag}" Visibility="{Binding HasFlag, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
