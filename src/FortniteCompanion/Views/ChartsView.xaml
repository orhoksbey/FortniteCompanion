<UserControl x:Class="FortniteCompanion.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FortniteCompanion.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="6,0,6,8">
        <StackPanel>
          <TextBlock Text="GRAFİKLER" Style="{StaticResource TitleText}" />
          <TextBlock Text="Günlük/haftalık grafikler yalnızca tarihi bilinen yeni maçları içerir; geçmişten eklenen toplamlar tarihsiz olduğu için gelişim grafiğinde başlangıç seviyesi olarak gösterilir." Style="{StaticResource HintText}" />
        </StackPanel>
      </DockPanel>

      <UniformGrid Columns="3">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="GÜNLÜK SANDIK (SON 14 GÜN)" Style="{StaticResource SectionText}" />
            <c:BarChart Height="190" Items="{Binding DailyPoints}" BarBrush="{DynamicResource AccentBrush}" TextBrush="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="HAFTALIK PERFORMANS (SON 8 HAFTA)" Style="{StaticResource SectionText}" />
            <c:BarChart Height="190" Items="{Binding WeeklyPoints}" BarBrush="{DynamicResource BlueBrush}" TextBrush="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="MAÇ BAŞINA SANDIK DAĞILIMI" Style="{StaticResource SectionText}" />
            <c:BarChart Height="190" Items="{Binding DistributionPoints}" BarBrush="{DynamicResource GreenBrush}" TextBrush="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ZAMAN İÇİNDEKİ GELİŞİM (TOPLAM SANDIK, SON 30 GÜN)" Style="{StaticResource SectionText}" />
          <c:LineChart Height="260" Series="{Binding ProgressSeries}" Labels="{Binding ProgressLabels}" TextBrush="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="KİŞİSEL REKORLAR" Style="{StaticResource SectionText}" />
          <ItemsControl ItemsSource="{Binding Records}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
