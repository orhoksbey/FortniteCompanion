<UserControl x:Class="FortniteCompanion.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="6,0,6,6">
        <Border DockPanel.Dock="Right" Style="{StaticResource Ribbon}" VerticalAlignment="Center"
                Visibility="{Binding InMatch, Converter={StaticResource BoolToVis}}" Background="#FFFF4D4D">
          <TextBlock Text="● MAÇ DEVAM EDİYOR" Style="{StaticResource RibbonText}" Foreground="White" />
        </Border>
        <StackPanel>
          <TextBlock Text="GENEL BAKIŞ" Style="{StaticResource TitleText}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" Margin="2,0,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Kahraman satırı: toplam sandık (efsanevi kart) + 4 nadirlik kartı -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Tile}" Background="{StaticResource TileLegendary}" ToolTip="{Binding TotalChestsSource}">
          <Grid>
            <Image Source="{StaticResource ChestIcon}" Width="170" Height="170" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Opacity="0.95" Margin="0,0,-6,0">
              <Image.Effect>
                <DropShadowEffect ShadowDepth="4" BlurRadius="14" Opacity="0.5" Color="#FF3A1500" />
              </Image.Effect>
            </Image>
            <StackPanel VerticalAlignment="Center">
              <Border Style="{StaticResource Ribbon}" Background="White">
                <TextBlock Text="TOPLAM SANDIK" Style="{StaticResource RibbonText}" />
              </Border>
              <TextBlock Text="{Binding TotalChests}" Style="{StaticResource TileValue}" FontSize="86" Margin="0,2,0,-6" />
              <TextBlock Text="{Binding SelfName}" Style="{StaticResource TileLabel}" FontSize="15" />
              <TextBlock Text="{Binding SelfAdjustText}" Style="{StaticResource TileHint}" Margin="0,2,0,0" />
              <Button Content="OYUNDAKİ SAYIYA EŞİTLE" Style="{StaticResource AccentButton}" Click="OnFixTotal" HorizontalAlignment="Left"
                      Margin="0,10,0,0" ToolTip="Oyun çöktüyse veya sayı tutmuyorsa: oyundaki sandık görevinde yazan sayıyı gir." />
              <TextBlock Text="Kaynak dağılımı için sayının üzerine gelin" Style="{StaticResource TileHint}" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <UniformGrid Grid.Column="1" Columns="2" Rows="2">
          <Border Style="{StaticResource Tile}" Background="{StaticResource TileRare}">
            <StackPanel>
              <TextBlock Text="TOPLAM MAÇ" Style="{StaticResource TileLabel}" />
              <TextBlock Text="{Binding TotalMatches}" Style="{StaticResource TileValue}" />
              <TextBlock Text="geçmiş + yeni benzersiz maçlar" Style="{StaticResource TileHint}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}" Background="{StaticResource TileUncommon}">
            <StackPanel>
              <TextBlock Text="SANDIK / MAÇ" Style="{StaticResource TileLabel}" />
              <TextBlock Text="{Binding AvgChests}" Style="{StaticResource TileValue}" />
              <TextBlock Text="toplam sandık ÷ toplam maç" Style="{StaticResource TileHint}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}" Background="{StaticResource TileEpic}">
            <StackPanel>
              <TextBlock Text="KILL / MAÇ" Style="{StaticResource TileLabel}" />
              <TextBlock Text="{Binding AvgKills}" Style="{StaticResource TileValue}" />
              <TextBlock Text="{Binding TotalKills, StringFormat='toplam {0} kill'}" Style="{StaticResource TileHint}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}" Background="{StaticResource TileCommon}">
            <StackPanel>
              <TextBlock Text="EN İYİ MAÇ" Style="{StaticResource TileLabel}" />
              <TextBlock Text="{Binding Best}" Style="{StaticResource TileValue}" FontSize="20" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>

      <!-- Bugün / hafta / sezon -->
      <UniformGrid Columns="3">
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock Text="BUGÜN" Style="{StaticResource LabelText}" DockPanel.Dock="Top" />
            <TextBlock Text="{Binding Today}" Style="{StaticResource ValueText}" FontSize="26" Foreground="{DynamicResource YellowBrush}" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock Text="BU HAFTA" Style="{StaticResource LabelText}" DockPanel.Dock="Top" />
            <TextBlock Text="{Binding Week}" Style="{StaticResource ValueText}" FontSize="26" />
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock Text="BU SEZON" Style="{StaticResource LabelText}" DockPanel.Dock="Top" />
            <TextBlock Text="{Binding Season}" Style="{StaticResource ValueText}" FontSize="26" />
          </DockPanel>
        </Border>
      </UniformGrid>

      <!-- Uyarılar -->
      <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1.5"
              Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Border Style="{StaticResource Ribbon}" Background="{DynamicResource WarningBrush}" Margin="0,0,0,8">
            <TextBlock Text="DİKKAT" Style="{StaticResource RibbonText}" />
          </Border>
          <TextBlock Text="{Binding WarningText}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Visibility="{Binding ShowReplayHelp, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="REPLAY KAYDINI AÇMA" Style="{StaticResource SectionText}" />
          <TextBlock Style="{StaticResource BodyText}"
                     Text="1. Fortnite'ı açın → Ayarlar (Settings) → Oyun (Game) sekmesi.&#10;2. &quot;Replays&quot; bölümünde &quot;Record Replays&quot; (Replay Kaydet) seçeneğini AÇIK yapın.&#10;3. Ekran modunu &quot;Pencereli Tam Ekran&quot; (Windowed Fullscreen) yapın; aksi hâlde overlay oyunun üstünde görünmez.&#10;4. Bir maç oynayın. Maç bitince birkaç saniye içinde sandıklar burada görünür." />
          <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                     Text="Not: Silinmiş veya hiç kaydedilmemiş eski maçlar geri getirilemez. Önceden tuttuğunuz toplamlar &quot;Geçmişten eklenen kayıtlar&quot; olarak eklendi." />
        </StackPanel>
      </Border>

      <!-- Son maçlar: Fortnite eşya kartı gibi, sandık sayısına göre nadirlik rengi -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{Binding LastMatch, StringFormat='Son maç: {0}'}" Style="{StaticResource HintText}"
                       DockPanel.Dock="Right" VerticalAlignment="Center" />
            <TextBlock Text="SON MAÇLAR" Style="{StaticResource SectionText}" />
          </DockPanel>
          <TextBlock Text="Henüz kayıtlı maç yok. Replay kaydı açıkken bir maç oynadığınızda burada görünür.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RecentMatches.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding RecentMatches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,4" CornerRadius="6" Background="{DynamicResource CardHighlight}" BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Nadirlik kutusu -->
                    <Border Background="{Binding RarityTile}" CornerRadius="5,0,0,5" Padding="8,6">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{StaticResource ChestIcon}" Width="22" Height="22" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChestsText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="White"
                                   Effect="{StaticResource HardShadow}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Mode}" Style="{StaticResource BodyText}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding KillsText, StringFormat='{}{0} KILL'}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="16" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,4,10,4">
                      <TextBlock Text="{Binding SourceLong}" Style="{StaticResource HintText}" />
                      <TextBlock Text="{Binding Flag}" Style="{StaticResource HintText}" Foreground="{DynamicResource WarningBrush}"
                                 Visibility="{Binding HasFlag, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Kaynak açıklaması -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="SAYILARIN KAYNAĞI" Style="{StaticResource SectionText}" />
          <TextBlock Style="{StaticResource BodyText}"
                     Text="• Replay ile doğrulandı: bu bilgisayarda kaydedilen replay'den, sizin açtığınız sandıklar (tam sayım).&#10;• Tahmini: takım arkadaşının replay'inden; replay yalnızca kaydedenin çevresini (~150 m) içerdiği için eksik olabilir.&#10;• Manuel girildi: canlı manuel sayaç veya elle eklenen maç. Aynı maçın replay'i gelirse manuel kayıt toplamdan çıkarılır.&#10;• Önceki istatistikten aktarıldı: uygulamadan önce tuttuğunuz toplamlar (Geçmişten eklenen kayıtlar).&#10;Mühimmat kutuları ve diğer konteynerler sandık toplamına dahil değildir; Maç Geçmişi'nde ayrı gösterilir.&#10;Kart renkleri maçtaki sandık sayısını gösterir: gri &lt; 8, yeşil 8–12, mavi 13–17, mor 18–24, altın 25+." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
