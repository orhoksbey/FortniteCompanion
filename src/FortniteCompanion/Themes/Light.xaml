<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Açık tema: gökyüzü mavisi arka plan, beyaz kartlar (aynı anahtarlar) -->
  <RadialGradientBrush x:Key="WindowBackground" GradientOrigin="0.5,-0.1" Center="0.5,-0.1" RadiusX="1.25" RadiusY="1.15">
    <GradientStop Color="#FFBFE3FF" Offset="0" />
    <GradientStop Color="#FF8CC4FF" Offset="0.45" />
    <GradientStop Color="#FF5F95F0" Offset="1" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F21B2F86" Offset="0" />
    <GradientStop Color="#E61B2F86" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarBackground" Color="#E61B2F86" />

  <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7FFFFFF" Offset="0" />
    <GradientStop Color="#E8F3F7FF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CardBorder" Color="#331B2F86" />
  <SolidColorBrush x:Key="CardHighlight" Color="#0F1B2F86" />

  <SolidColorBrush x:Key="InputBackground" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="InputBorder" Color="#4D1B2F86" />
  <SolidColorBrush x:Key="TextPrimary" Color="#FF0F1640" />
  <SolidColorBrush x:Key="TextSecondary" Color="#CC2A3A78" />
  <SolidColorBrush x:Key="TextMuted" Color="#A64A5890" />
  <SolidColorBrush x:Key="TextOnTile" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextOnAccent" Color="#FF14123A" />
  <SolidColorBrush x:Key="HoverBackground" Color="#1A1B2F86" />
  <SolidColorBrush x:Key="SelectedBackground" Color="#2E1B2F86" />
  <SolidColorBrush x:Key="GridLine" Color="#1F1B2F86" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFC77700" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FFD02B3E" />

  <SolidColorBrush x:Key="YellowBrush" Color="#FFFFE14D" />
  <SolidColorBrush x:Key="GreenBrush" Color="#FF1FA83A" />
  <SolidColorBrush x:Key="BlueBrush" Color="#FF1677D9" />
  <SolidColorBrush x:Key="GoldBrush" Color="#FFD49A00" />
  <SolidColorBrush x:Key="PurpleBrush" Color="#FF8A4FE0" />

  <LinearGradientBrush x:Key="OverlayBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EBFFFFFF" Offset="0" />
    <GradientStop Color="#EBE6EEFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="OverlayBorder" Color="#4D1B2F86" />
  <SolidColorBrush x:Key="OverlayText" Color="#FF0F1640" />
  <SolidColorBrush x:Key="OverlayLabel" Color="#CC2A3A78" />
</ResourceDictionary>
