<Window x:Class="FortniteCompanion.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Companion Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource CondensedFont}">

  <Window.Resources>
    <!-- Oyun içi yazılar gibi keskin koyu gölge -->
    <DropShadowEffect x:Key="TextShadow" ShadowDepth="2" Direction="300" BlurRadius="1" Opacity="0.9" Color="#FF06041C" />
    <Style x:Key="OvLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource OverlayLabel}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,18,2" />
    </Style>
    <Style x:Key="OvValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource OverlayText}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Effect" Value="{StaticResource TextShadow}" />
    </Style>
  </Window.Resources>

  <Border x:Name="Card"
          CornerRadius="7"
          Padding="14,10,14,10"
          Background="{DynamicResource OverlayBackground}"
          BorderBrush="{DynamicResource OverlayBorder}"
          BorderThickness="1"
          MinWidth="240">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
    </Border.LayoutTransform>

    <StackPanel>
      <!-- Başlık: eğik sarı şerit -->
      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#FFFF4D4D" Margin="8,0,5,0" Visibility="Collapsed" />
          <TextBlock x:Name="LiveText" Text="MAÇTA" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                     Foreground="#FFFF6B6B" Effect="{StaticResource TextShadow}" Visibility="Collapsed" />
        </StackPanel>
        <Border Background="{DynamicResource AccentBrush}" Padding="9,1,11,1" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform>
            <SkewTransform AngleX="-12" />
          </Border.RenderTransform>
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource ChestIcon}" Width="15" Height="15" Margin="0,0,5,0" />
            <TextBlock Text="FORTNITE COMPANION" FontFamily="{StaticResource DisplayFont}" FontSize="12.5" Foreground="#FF14123A" />
          </StackPanel>
        </Border>
      </DockPanel>

      <!-- Toplam -->
      <TextBlock Text="TOPLAM SANDIK" Style="{StaticResource OvLabel}" Margin="0" />
      <StackPanel Orientation="Horizontal" Margin="0,-2,0,0">
        <Image Source="{StaticResource ChestIcon}" Width="30" Height="30" Margin="0,2,8,0" VerticalAlignment="Center" />
        <TextBlock x:Name="TotalText" Text="0" FontSize="42" FontFamily="{StaticResource DisplayFont}"
                   Foreground="{DynamicResource AccentBrush}" Effect="{StaticResource TextShadow}"
                   RenderTransformOrigin="0,0.6">
          <TextBlock.RenderTransform>
            <ScaleTransform x:Name="TotalScale" ScaleX="1" ScaleY="1" />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="PlusText" Text="+0" FontSize="22" FontFamily="{StaticResource DisplayFont}" Foreground="#FF5CE05A"
                   Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0" Effect="{StaticResource TextShadow}">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="PlusShift" Y="0" />
          </TextBlock.RenderTransform>
        </TextBlock>
      </StackPanel>
      <TextBlock x:Name="SourceText" Text="" FontSize="10" Foreground="{DynamicResource OverlayLabel}" Margin="0,-2,0,6" />

      <Border Height="2" Background="{DynamicResource OverlayBorder}" Margin="0,0,0,6" CornerRadius="1" />

      <!-- Satırlar -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BU MAÇ" Style="{StaticResource OvLabel}" />
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MatchText" Text="—" Style="{StaticResource OvValue}" Foreground="#FF4FC3FF" />

        <TextBlock Grid.Row="1" Text="BUGÜN" Style="{StaticResource OvLabel}" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TodayText" Text="0" Style="{StaticResource OvValue}" />

        <TextBlock Grid.Row="2" Text="MAÇ ORTALAMASI" Style="{StaticResource OvLabel}" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AvgText" Text="0,0" Style="{StaticResource OvValue}" />

        <TextBlock Grid.Row="3" Text="SON MAÇ" Style="{StaticResource OvLabel}" />
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastText" Text="—" Style="{StaticResource OvValue}" Foreground="#FF5CE05A" />

        <TextBlock Grid.Row="4" x:Name="TeamLabel" Text="TAKIM (SON MAÇ)" Style="{StaticResource OvLabel}" />
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TeamText" Text="—" Style="{StaticResource OvValue}" Foreground="#FFC17BFF" />
      </Grid>

      <TextBlock x:Name="StatusText" Text="" FontSize="10.5" Foreground="{DynamicResource OverlayLabel}"
                 Margin="0,6,0,0" MaxWidth="260" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>
